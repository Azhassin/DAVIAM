# Copy this file to DAVIAM/.env and fill in the values.
# Never commit DAVIAM/.env. None of the values below are real secrets.

# Shown in the greeting and in the system prompt.
Username=Your Name
Assistantname=DAVIAM
FullForm=Dynamic Automated Virtual Interactive Assistant Model

# Web Speech API language tag. Examples: en-US, en-GB, en-IN, hi-IN.
InputLanguage=en-US

# An edge-tts short name. See "DAVIAM/Edge-tts Voices.txt".
# British English examples: en-GB-RyanNeural, en-GB-SoniaNeural, en-GB-LibbyNeural.
AssistantVoice=en-US-JennyNeural

# Required for conversation, content writing, and realtime answers.
# https://console.groq.com/keys
GroqAPIKey=

# Required for intent routing (open, search, generate image, and so on).
# Without it, every request is treated as general chat.
# https://dashboard.cohere.com/api-keys
CohereAPIKey=

# Required for image generation. The token needs permission to call Inference Providers.
# https://huggingface.co/settings/tokens
HuggingFaceAPIKey=

# Optional overrides. The defaults are current public model ids.
GroqModel=openai/gpt-oss-120b
CohereModel=command-a-03-2025

# Speech input: auto (Chrome when a display is available, otherwise text),
# browser, or text. Text mode reads the terminal, or DAVIAM/Frontend/Files/Query.data.
DAVIAM_SPEECH=auto
